{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": "./.puzzletest",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/libs/puzzles/**/*.ts",
    "src/data/story/index.ts",
    "src/libs/sqlite/story.ts"
  ]
}
