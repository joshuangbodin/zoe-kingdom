{
  "expo": {
    "name": "zoe-kingdom",
    "slug": "zoe-kingdom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zoekingdom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jo_sh_ie_ee.zoekingdom"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/font/Sora/Sora-Regular.ttf",
            "./assets/font/Sora/Sora-Medium.ttf",
            "./assets/font/Sora/Sora-SemiBold.ttf",
            "./assets/font/Sora/Sora-Bold.ttf",
            "./assets/font/Serif/NotoSerif-Regular.ttf",
            "./assets/font/Serif/NotoSerif-Italic.ttf"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f3ef346-8646-4006-bb45-5435d3a157ed"
      }
    }
  }
}
